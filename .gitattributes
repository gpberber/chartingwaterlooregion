# GitHub Pages reads CNAME as a plain one-line file. Keep it Unix line endings so a
# Windows checkout never rewrites it with a carriage return.
CNAME text eol=lf

# Font files are binary. Git's auto-detection already gets this right, but a woff2
# that ever went through line-ending conversion would be silently corrupt and the
# site would fall back to a system font without an error anywhere - so say it.
*.woff2 binary

# Shell scripts run under bash, which reads a carriage return as part of the
# command ("exit 0\r" fails). Keep the hooks in _dev/ on Unix line endings.
*.sh text eol=lf
_dev/hooks/pre-commit text eol=lf
