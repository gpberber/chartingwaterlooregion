	    #guide = "none"    # uncomment if want no legend
	  ) +
	
	  # Horizontal chart: swap tufte's default grid orientation
	  # clip = "off" needed to show rectangles and header beyond panel
	  theme(
	    axis.text.y.left = element_markdown(),
	    axis.ticks.x = element_blank(),
	    axis.line.x = element_blank(),
	    panel.grid.major.x = element_line(color = "grey80", linewidth = 0.3),
	    panel.grid.major.y = element_blank()
	  ) +
	
	  coord_cartesian(clip = "off") +
	
	  labs(
	    title = "Title",
	    subtitle = "Subtitle",
	    caption = "Source: Source | *Charting Waterloo Region*"
	  )

snippet ggdumbbellrect
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning
	plot_data <- ${1:data_object} |>
	  filter(${2:x_column} %in% c(${3:value1}, ${4:value2})) |>
	  pivot_wider(
	    id_cols = ${5:y_column},
	    names_from = ${2:x_column},
	    values_from = ${6:value_column}
	  ) |>
	  mutate(
	    ${5:y_column} = reorder(${5:y_column}, `${3:value1}`),
	    ${11:rect_variable} = round(${11:rect_variable}, ${12:0}),
	    y_label = if_else(${5:y_column} == "${7:highlight_value}", "**${7:highlight_value}**", as.character(${5:y_column}))
	  )
	
	# Pre-compute labels to avoid data masking issue in scale_y_discrete
	y_labels <- plot_data |> select(${5:y_column}, y_label) |> deframe()
	
	plot_data |>
	  ggplot() +
	
	  # Background reference segment spanning full x range
	  geom_segment(aes(
	    x = 0,
	    xend = ${10:max_x},
	    y = ${5:y_column},
	    yend = ${5:y_column}
	    ),
	    color = "grey80",
	    linewidth = 0.3
	  ) +
	
	  # Dumbbell segment connecting x1 to x2
	  geom_segment(aes(
	    x = `${3:value1}`,
	    xend = `${4:value2}`,
	    y = ${5:y_column},
	    yend = ${5:y_column}
	    ),
	    color = "grey50",
	    linewidth = 0.7
	  ) +
	
	  geom_point(aes(
	    x = `${3:value1}`,
	    y = ${5:y_column},
	    color = "${8:x1_label}"
	    ),
	    shape = 19, size = 4
	  ) +
	
	  geom_point(aes(
	    x = `${4:value2}`,
	    y = ${5:y_column},
	    color = "${9:x2_label}"
	    ),
	    shape = 19, size = 4
	  ) +
	
	  geom_vline(
	    xintercept = 0,
	    color = "black",
	    linewidth = 0.5
	  ) +
	
	  # Boxed right-side data labels
	  geom_label(
	    aes(
	      x = ${13:rect_x},
	      y = ${5:y_column},
	      label = paste0(formatC(${11:rect_variable}, format = "f", digits = ${14:1}, flag = " "), "${15:rect_suffix}")
	    ),
	    hjust = 1,
	    size = 3.2,
	    fill = "grey90",
	    colour = "grey30",
	    linewidth = 0,
	    label.padding = unit(0.3, "lines")
	  ) +
	
	  # Shaded column header above rectangles
	  annotate(
	    "label",
	    x = ${13:rect_x},
	    y = Inf,
	    label = "${16:rect_header}",
	    hjust = 1,
	    vjust = -1.0,
	    size = 3.2,
	    fontface = "plain",
	    fill = "grey90",
	    colour = "grey30",
	    linewidth = 0,
	    label.padding = unit(0.3, "lines")
	  ) +
	
	  scale_color_manual(
	    values = c(
	      "${8:x1_label}" = cowboysilver,
	      "${9:x2_label}" = dodgerblue
	    ),
	    name = NULL,
	    breaks = c("${8:x1_label}", "${9:x2_label}")
	  ) +
	
	  scale_x_continuous(
	    limits = c(${17:x_min}, ${13:rect_x}),
	    #breaks = seq(${17:x_min}, ${18:x_max}, ${19:by}),
	    labels = label_number(big.mark = ",", scale = 1, suffix = ""),
	    expand = expansion(mult = c(0.02, 0.3)),
	    position = "top"
	  ) +
	
	  scale_y_discrete(
	    position = "left",
	    labels = y_labels
	  ) +
	
	  # Horizontal chart: swap tufte's default grid orientation
	  # clip = "off" needed to show rectangles and header beyond panel
	  theme(
	    axis.text.y.left = element_markdown(),
	    axis.ticks.x = element_blank(),
	    axis.line.x = element_blank(),
	    panel.grid.major.x = element_line(color = "grey80", linewidth = 0.3),
	    panel.grid.major.y = element_blank(),
	    legend.position = "inside",
	    legend.justification = c(0, 1),
	    legend.position.inside = c(0.05, 0.9),
	    legend.direction = "vertical",
	    legend.background = element_rect(fill = "white", color = NA)
	  ) +
	
	  coord_cartesian(clip = "off") +
	
	  labs(
	    title = "Title",
	    subtitle = "Subtitle",
	    caption = "Source: Source | *Charting Waterloo Region*"
	  )

snippet ggarrowrect
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning
	plot_data <- ${1:data_source} |>
	  filter(${2:x_column} %in% c(${3:value1}, ${4:value2})) |>
	  pivot_wider(
	    id_cols = ${5:y_column},
	    names_from = ${2:x_column},
	    values_from = ${6:value_column}
	  ) |>
	  mutate(
	    ${5:y_column} = reorder(${5:y_column}, `${3:value1}`),
	    ${12:rect_variable} = round(${12:rect_variable}, ${13:0}),
	    y_label = if_else(${5:y_column} == "${7:highlight_value}", "**${7:highlight_value}**", as.character(${5:y_column}))
	  )
	
	# Pre-compute labels to avoid data masking issue in scale_y_discrete
	y_labels <- plot_data |> select(${5:y_column}, y_label) |> deframe()
	
	plot_data |>
	  ggplot(aes(y = ${5:y_column})) +
	
	  # Background reference segment spanning full x range
	  geom_segment(aes(
	    x = 0,
	    xend = ${8:max_x},
	    y = ${5:y_column},
	    yend = ${5:y_column}
	    ),
	    color = "grey80",
	    linewidth = 0.3
	  ) +
	
	  geom_vline(xintercept = 0, linewidth = 0.5) +
	
	  geom_segment(
