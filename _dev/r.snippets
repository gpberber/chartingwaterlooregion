	      manual_5_colours,
	      c(
	        "${6:group1}",
	        "${7:group2}",
	        "${8:group3}",
	        "${9:group4}",
	        "${10:group5}"
	      )
	    ),
	    #guide = "none"    # uncomment if want no legend
	  ) +
	
	  # Horizontal chart: swap tufte's default grid orientation
	  theme(
	    axis.text.y.left = element_markdown(),
	    axis.ticks.x = element_blank(),
	    axis.line.x = element_blank(),
	    panel.grid.major.x = element_line(color = "grey80", linewidth = 0.3),
	    panel.grid.major.y = element_blank()
	  ) +
	
	  labs(
	    title = "Title",
	    subtitle = "Subtitle",
	    caption = "Source: Source | *Charting Waterloo Region*"
	  )
	  
snippet ggscatter
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning
	plot_data <- ${1:data_source} |>
	  pivot_wider(
	    id_cols = ${2:column_id},
	    names_from = ${3:column_names},
	    values_from = ${4:column_values}
	  )
	
	# Point label nudge values - set per-point after initial render
	# nudge values are in the same units as the x and y axes
	# nudge_data <- plot_data |>
	#   mutate(
	#     nudge_x = case_when(
	#       ${2:column_id} == "id1" ~ 0,
	#       ${2:column_id} == "id2" ~ 0,
	#       ${2:column_id} == "id3" ~ 0,
	#       ${2:column_id} == "id4" ~ 0,
	#       ${2:column_id} == "id5" ~ 0,
	#       .default = 0
