	    subtitle = "Subtitle",
	    caption = cwr_caption("Source")
	  )
		
snippet ggslope
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning
	# Define groups based on y variable
	orig_groups <- c("${1:group1_orig}", "${2:group2_orig}", "${3:group3_orig}", "${4:group4_orig}", "${55:group5_orig}")
	renamed_groups <- c("${6:group1_name}", "${7:group2_name}", "${8:group3_name}", "${9:group4_name}", "${10:group5_name}") # define display names

	# Define plot data
	plot_data <- ${11:source} |> 
		filter(
		  ${12:x_variable} %in% c(${13:x1_variable}, ${14:x2_variable})
		) |>
		mutate(
			${15:colour_var} = str_replace_all(${15:colour_var}, set_names(renamed_groups, orig_groups))
		)
		
	# Set x min and max
	x_min = plot_data |> pull(${12:x_variable}) |> min()
	x_max = plot_data |> pull(${12:x_variable}) |> max()
	
	# Define line colours
	group_colours <- set_names(manual_5_colours, renamed_groups)  # adjust for number of groups
	
	# Label positions - adjust x and y values once known
	#label_data <- tibble(
	#  x     = c(x1, x2, x3, x4, x5),
	#  y     = c(y1, y2, y3, y4, y5),
	#  label = renamed_groups,
	#	 fontface = c("plain", "plain", "plain", "plain", "plain"),  # set desired to bold
	#  If want label scoped to one facet panel (facet_level), uncomment and edit spec below
	#	 Note facet_var must be a factor with the same levels as in plot_data (need to factor it in plot_data if not already done)
	#	 facet_var = factor("facet_level", levels = levels(${7:plot_data}\$facet_var)),
	#)
	
	ggplot(plot_data, aes(x = ${12:x_variable}, y = ${16:y_variable}, colour = ${15:colour_var}, group = ${17:group_var})) +
	
	  # commented out until label placements determined
		#geom_label(
		#  data = label_data,
		#  aes(
		#    x = x,
		#    y = y,
		#    label = label,
		#    fontface = fontface
		#  ),
		#	 colour = "grey30",
		#  fill = "white", 
		#  linewidth = 0,
		#  size = 3.2,
		#  hjust = 0,       # 0 left, 1 right, 0.5 default centered
		#	 vjust = 0,				# 0 bottom, 1 top, 0.5 default centered
		#  inherit.aes = FALSE
		#) +
	
	  geom_line(linewidth = 0.8) +
	  
	  geom_point(size = 3.1, colour = "white") +  # add white point to obscure line ends
	
	  geom_point(size = 3.0) +
	
	  scale_x_continuous(
	    breaks = c(x_min, x_max),
	    expand = expansion(mult = c(0.05, 0.08))
	  ) +
	
	  scale_y_continuous(
	    #limits = c(min, max),
	    position = "right",
	    #breaks = seq(min, max, by),
	    labels = label_number(big.mark = ",", scale = 1, suffix = ""),
	    expand = expansion(mult = c(0, 0.05))
	  ) +
	
	  scale_colour_manual(
	    values = group_colours,
	    guide = "none"
	  ) +
	
	  # Right-axis label positioning: sit labels above gridlines
	  theme(
	    axis.text.y.right = element_text(
	      size = rel(1),
	      hjust = 1.0,
	      vjust = -0.5,
	      margin = margin(r = 12, l = -20)
	    ),
	    plot.margin = margin(t = 13, l = 13, b = 13, r = 200)   # make plot area thinner
	  ) +
	
	  labs(
	    title = "Title",
	    subtitle = "Subtitle",
	    caption = cwr_caption("Source")
	  )
	  
snippet ggheatrank
	# HEATMAP TEMPLATE FOR RANKED DATA
	# Replace placeholders: data_ranked, x_var, y_var, ranking_var, colors, breaks,
	# labels, x axis breaks, legend coords
	
	# Create y-axis ordering vector
	# Calculate average ranking and reorder regions (best at top)
	row_order <- ${1:data_ranked} |> 
	  group_by(${2:y_var}) |> 
	  summarise(avg_rank = mean(${3:ranking_var}, na.rm = TRUE)) |>  # adjust for ranking method
	  arrange(avg_rank) |>  # add desc() if lower avg is better
	  pull(${2:y_var})
	
	# Define special formatting
	highlight_row <- "${4:special_row_name}"  # Row to highlight (optional)
	
	# Prepare data with ordering and special formatting
	plot_data <- ${1:data_ranked} |> 
	  mutate(
	    row_factor = factor(${2:y_var}, levels = row_order),
	    row_label = if_else(${2:y_var} == highlight_row, paste0("**", highlight_row, "**"), as.character(${2:y_var}))
	  )
	  
	# Set x min and max
	x_min = plot_data |> pull(${5:x_var}) |> min()
	x_max = plot_data |> pull(${5:x_var}) |> max()
	  
	# Pre-compute labels to avoid data masking issue in scale_y_discrete
	y_labels <- plot_data |> select(row_factor, row_label) |> deframe()
	
	# Define fill scale parameters
	fill_colors <- alpha(${6:dodgerblue4}, c(0.1, 0.4, 0.7, 1.0))  # Adjust alphas as needed (one fewer than num breaks)
	#fill_breaks <- c(break1, break2, break3, break4, break5)          # Adjust breaks
	fill_labels <- c("label1", "label2", "label3", "label4", "label5")  # Adjust labels
	
	ggplot(plot_data, aes(x = ${5:x_var}, y = row_factor, fill = ${3:ranking_var})) +
	  
	  geom_tile(color = "white", linewidth = 0.5) +
	  
	  scale_fill_stepsn(
	    colors = fill_colors,
	    n.breaks = 5,
	    labels = label_number(big.mark = ",", scale = 1, suffix = ""),
	    #breaks = fill_breaks,
	    #labels = fill_labels,
	    na.value = "black",
	    guide = guide_coloursteps(
	      reverse = FALSE, 
	      show.limits = FALSE,
	      barwidth = unit(4, "cm"),
	      barheight = unit(0.4, "cm"),
	      frame.colour = "black",
	      frame.linewidth = 0.3,
	      label.vjust = -0.0
	    )
	  ) +
	  
	  scale_x_continuous(
	    #limits = c(min, max),
	    #breaks = seq(min, max, by),
	    #minor_breaks = seq(x_min, x_max, 1),
	    labels = label_number(big.mark = "", scale = 1, suffix = ""),
	    expand = expansion(mult = c(0.0, 0.0)),
	    position = "bottom"
	  ) +
	  
	  scale_y_discrete(
	    labels = y_labels
	  ) +
	  
	  guides(x = guide_axis(minor.ticks = TRUE)) +
	  
	  # Heatmap: remove all gridlines (tiles define the structure),
	  theme(
	  	axis.text.y.left = element_markdown(),
	    panel.grid.major.y = element_blank(),
	    legend.position = "top"
	  ) +
	  
	  labs(
	    title = "Title",
	    subtitle = "Subtitle",
	    caption = cwr_caption("Source")
	  )
	  
snippet ggheatraw
	# HEATMAP (RAW VALUES) TEMPLATE
	# Replace placeholders: data_source, x_var, y_var, value_var, colors, breaks, labels
	
	# Create y-axis ordering vector
	# Order rows by mean of raw value (highest at top)
	row_order <- ${1:data_source} |> 
	  group_by(${2:y_var}) |> 
	  summarise(avg_val = mean(${3:value_var}, na.rm = TRUE)) |>
	  arrange(desc(avg_val)) |>  # remove desc() if lower avg should be at top
	  pull(${2:y_var})
	
	# Define special formatting
	highlight_row <- "${4:special_row_name}"  # Row to highlight (optional)
	
	# Prepare data with ordering and special formatting
	plot_data <- ${1:data_source} |> 
	  mutate(
	    row_factor = factor(${2:y_var}, levels = row_order),
	    row_label = if_else(${2:y_var} == highlight_row, paste0("**", highlight_row, "**"), as.character(${2:y_var}))
	  )
	  
	# Set x min and max
	x_min = plot_data |> pull(${5:x_var}) |> min()
	x_max = plot_data |> pull(${5:x_var}) |> max()
	  
	# Pre-compute labels to avoid data masking issue in scale_y_discrete
	y_labels <- plot_data |> select(row_factor, row_label) |> deframe()
	
	# Define fill scale parameters
	fill_colors <- alpha(${6:dodgerblue4}, c(0.1, 0.4, 0.7, 1.0))  # Adjust alphas as needed (one fewer than num breaks)
	#fill_breaks <- c(break1, break2, break3, break4, break5)           # Set breaks based on data range
	fill_labels <- c("label1", "label2", "label3", "label4", "label5")  # Adjust labels
	
	ggplot(plot_data, aes(x = ${5:x_var}, y = row_factor, fill = ${3:value_var})) +
	  
	  geom_tile(color = "white", linewidth = 0.5) +
	  
	  # Optional: add value labels inside tiles
	  #geom_text(
	  #  aes(label = label_number(big.mark = ",", scale = 1, suffix = "")(${3:value_var})),
	  #  colour = "white",
	  #  size = 3.2
	  #) +
	  
	  scale_fill_stepsn(
	    colors = fill_colors,
	    n.breaks = 5,
	    labels = label_number(big.mark = ",", scale = 1, suffix = ""),
	    #breaks = fill_breaks,
	    #labels = fill_labels,
	    na.value = "grey80",
	    guide = guide_coloursteps(
	      reverse = FALSE,
	      show.limits = FALSE,
	      barwidth = unit(4, "cm"),
	      barheight = unit(0.4, "cm"),
	      frame.colour = "black",
	      frame.linewidth = 0.3,
	      label.vjust = -0.0
	    )
	  ) +
	  
	  scale_x_continuous(
	    #limits = c(min, max),
	    #breaks = seq(min, max, by),
	    #minor_breaks = seq(x_min, x_max, 1),
	    labels = label_number(big.mark = "", scale = 1, suffix = ""),
	    expand = expansion(mult = c(0.0, 0.0)),
	    position = "bottom"
	  ) +
	  
	  scale_y_discrete(
	    labels = y_labels
	  ) +
	  
	  guides(x = guide_axis(minor.ticks = TRUE)) +
	  
	  # Heatmap: remove all gridlines (tiles define the structure),
	  theme(
	  	axis.text.y.left = element_markdown(),
	    panel.grid.major.y = element_blank(),
	    legend.position = "top"
	  ) +
	  
	  labs(
	    title = "Title",
	    subtitle = "Subtitle",
	    caption = cwr_caption("Source")
	  )
	
snippet ggmultiples
	make_multiples_plot <- function(data, multiple_label, show_title = FALSE) {
		data |>
		  filter(${1:facet_variable} == multiple_label) |>
		  mutate(${2:y_variable} = fct_reorder(${2:y_variable}, ${3:x_variable})) |>
		  # INSERT CHART SNIPPET HERE (must start with ggplot(...))
		  # Replace labs(title = ...) with: 
		  labs(title = multiple_label) +
			theme(
			  plot.title = element_markdown(size = base_size * 0.8),
			  legend.position = "none"
			)
		}
		
	plot_data <- ${4:main_table} |>
		select(
		  ${3:x_variable} = ${5:x_column},
		  ${2:y_variable} = ${6:y_column},
		  ${1:facet_variable} = ${7:facet_column}
		)
	
	p1 <- make_multiples_plot(plot_data, "${8:multiple_label1}")
	p2 <- make_multiples_plot(plot_data, "${9:multiple_label2}")
	p3 <- make_multiples_plot(plot_data, "${10:multiple_label3}")
	p4 <- make_multiples_plot(plot_data, "${11:multiple_label4}")
	
	(p1 / p2 / p3 / p4) +
	plot_annotation(
	  title = "Title",
	  subtitle = "Subtitle",
	  caption = cwr_caption("Source")
	)

snippet ggcompbar_horiz
	${1:data_source} |>
	  pivot_wider(
	    id_cols = ${2:y_variable},
	    names_from = ${3:group_var},
	    values_from = ${4:value_var}
	  ) |>
	  mutate(${2:y_variable} = fct_reorder(${2:y_variable}, `${5:x1_name}`)) |>
	  ggplot() +
	  geom_col(aes(y = ${2:y_variable}, x = `${5:x1_name}`, fill = "${5:x1_name}"), width = 0.5) +
	  geom_col(aes(y = ${2:y_variable}, x = `${6:x2_name}`, fill = "${6:x2_name}"), width = 0.3) +
	  # OPTION: replace second geom_col above with this code if want line instead of bar
	  # geom_segment(
	  #   aes(
	  #     y = as.numeric(${2:y_variable}) - 0.3,
	  #     yend = as.numeric(${2:y_variable}) + 0.3,
	  #     x = `${6:x2_name}`,
	  #     xend = `${6:x2_name}`
	  #   ),
	  #   colour = cowboysilver,
	  #   linewidth = ${7:1.0}
	  # ) +
	  scale_fill_manual(
	    values = c(
	      "${5:x1_name}" = dodgerblue,
	      "${6:x2_name}" = cowboysilver   # remove if using comparison line instead of bar
	    )
	  ) +
	  scale_x_continuous(
	    #limits = c(min, max),
	    #breaks = seq(min, max, by),
	    labels = label_number(big.mark = ",", scale = 1, suffix = ""),
	    expand = expansion(mult = c(0, 0.05)),
	    position = "top"
	  ) +
	  scale_y_discrete(
	    position = "left"
	  ) +
	  # Horizontal chart: swap tufte's default grid orientation
	  theme(
	    axis.ticks.x = element_blank(),
	    axis.line.x = element_blank(),
	    panel.grid.major.x = element_line(color = "grey80", linewidth = 0.3),
	    panel.grid.major.y = element_blank(),
	    # Inside legend, stacked, anchored at bottom-right corner, white background
	    legend.position = "inside",
	    legend.position.inside = c(${8:0.95}, ${9:0.05}),  # x, y as plot proportions
	    legend.justification = c(1, 0),                      # anchor: right edge, bottom edge
	    legend.direction = "vertical",
	    legend.background = element_rect(fill = "white", color = NA)
	  ) +
	  labs(
	    title = "Title",
	    subtitle = "Subtitle",
	    caption = cwr_caption("Source")
	  )

snippet ggcompbar_vert
	# set fig.width to help reduce gap between bars
	${1:data_source} |>
	  pivot_wider(
	    id_cols = ${2:x_variable},
	    names_from = ${3:group_var},
	    values_from = ${4:value_var}
	  ) |>
	  mutate(${2:x_variable} = fct_reorder(${2:x_variable}, `${5:y1_name}`)) |>
	  ggplot() +
	  geom_col(aes(x = ${2:x_variable}, y = `${5:y1_name}`, fill = "${5:y1_name}"), width = 0.5) +
	  geom_col(aes(x = ${2:x_variable}, y = `${6:y2_name}`, fill = "${6:y2_name}"), width = 0.3) +
	  # OPTION: replace second geom_col above with this code if want line instead of bar
		# geom_segment(
		#   aes(
		#     x = as.numeric(${2:x_variable}) - 0.3,
		#     xend = as.numeric(${2:x_variable}) + 0.3,
		#     y = `${6:y2_name}`,
		#     yend = `${6:y2_name}`
		#   ),
		#   colour = cowboysilver,
		#   linewidth = ${7:1.0}
		# ) +
	  scale_fill_manual(
	    values = c(
	      "${5:y1_name}" = dodgerblue,
