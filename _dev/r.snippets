	    arrow = arrow(length = unit(0.3, "cm"), type = "open"),
	    linewidth = 1.0,
	    color = dodgerblue
	  ) +
	
	  annotate(
	    "label",
	    x = ${9:label_x},
	    y = ${10:label_y},
	    label = "${11:annotation_text}",
	    fill = "white",
	    linewidth = 0,
	    size = 3.2
	  ) +
	
	  # Boxed right-side data labels
	  geom_label(
	    aes(
	      x = ${14:rect_x},
	      y = ${5:y_column},
	      label = paste0(formatC(${12:rect_variable}, format = "f", digits = ${15:1}, flag = " "), "${16:rect_suffix}")
	    ),
	    hjust = 1,
	    size = 3.2,
	    fill = "grey90",
	    colour = "grey30",
	    linewidth = 0,
	    label.padding = unit(0.3, "lines")
	  ) +
	
	  # Shaded column header above rectangles
