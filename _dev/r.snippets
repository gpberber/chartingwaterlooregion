snippet ggtitles
	labs(
		title = "${1:Title}",
		subtitle = "${2:Subtitle}",
		caption = "Source: ${3:Source} | *Charting Waterloo Region*"
	) +

snippet ggscalex_cont
	scale_x_continuous(
	  #limits = c(min, max),
	  #breaks = c(min, max, by), end_max),
	  labels = label_number(scale = ${4:1}, suffix = "${5:}", big.mark = ""),
	  #minor_breaks = seq(min, max, 1),
	  expand = expansion(mult = c(0.02, 0.05)),
	  position = "${7:bottom}"
	) +
	guides(x = guide_axis(minor.ticks = TRUE)) +

snippet ggscaley_cont
	scale_y_continuous(
	  #limits = c(${1:min}, ${2:max}),
	  breaks = c(seq(${1:min}, ${2:max}, ${3:by}), ${2:max}),
	  labels = label_number(scale = ${4:1}, suffix = "${5:}", big.mark = ","),
	  #minor_breaks = seq(${1:min}, ${2:max}, ${6:1}),
	  expand = expansion(mult = c(0.0, 0.05)),
	  position = "right"
	) +

snippet ggscalex_date
	# x_min and x_max must be defined before using this scale
	scale_x_date(
	  # Option 1: automatic breaks
	  date_breaks = "${1:5 years}",
	  # Option 2: manual breaks anchored to data start - comment out date_breaks above
	  # breaks = c(
	  #   x_min,   # change if want start at different date
	  #   seq.Date(
	  #     as.Date(paste0(year(x_min) + ${2:5}, "-01-01")),  # adjust month/day number if first date isn't in January 1
	  #     x_max,   # change if want start at different date
	  #     by = "${2:5} years"
	  # )),
	  date_labels = "${3:%Y}",
	  # Option 1: automatic breaks
	  date_minor_breaks = "${4:1 year}",
	  # Option 2: manual breaks anchored to desired start - comment out date_breaks above
	  #minor_breaks = seq.Date(
		  #  as.Date("min_minor_date"),
		  #  as.Date("max_minor_date"),
		  #  by = "1 years"
		#),
	  expand = expansion(mult = c(0.02, 0.05))
	) +
	guides(x = guide_axis(minor.ticks = TRUE)) +

snippet ggscalex_disc
	scale_x_discrete(
	  #limits = c("${1:level1}", "${2:level2}"),  # use to reorder or restrict levels
	  labels = c(
	    "${1:level1}" = "${3:label1}",
	    "${2:level2}" = "${4:label2}"
	  ),
	  expand = expansion(mult = c(0.05, 0.05)),
	  position = "${5:bottom}"
	) +

snippet ggscaley_disc
	# Pre-compute labels to avoid data masking issue in scale_y_discrete
	# y_labels <- plot_data |> select(y_variable, y_label) |> deframe()
	scale_y_discrete(
	  #limits = c("${1:level1}", "${2:level2}"),  # use to reorder or restrict levels
	  labels = y_labels,
	  expand = expansion(mult = c(0.05, 0.05)),
	  position = "left"
	) +
	theme(
	  axis.text.y.left = element_markdown()
	) +

snippet ggscale_color
	# adjust number of colors/names to suit data
	scale_color_manual(
		values = set_names(
			manual_5_colours, 
			c(
				"${1:group1}", 
				"${2:group2}", 
				"${3:group3}",
				"${4:group4}",
				"${5:group5}"
			)
		),
		#guide = "none"    # uncomment if want no legend
	) +

snippet ggscale_fill
	# adjust number of colors/names to suit data
	scale_fill_manual(
		values = set_names(
			manual_5_colours, 
			c(
				"${1:group1}", 
				"${2:group2}", 
				"${3:group3}",
				"${4:group4}",
				"${5:group5}"
			)
		),
		#guide = "none"    # uncomment if want no legend
	) +

snippet ggviridis
	scale_${1:color}_viridis_${2:d}(name = "${3:Legend title}")

snippet gglegend
	theme(
		legend.position = "inside",
		  legend.position.inside = c(-0.0, 1.02),
		  legend.justification = "left",
		  legend.box = "horizontal",
		  #legend.margin = margin(t = 20, b = 20),
		  legend.direction = "horizontal",
		  legend.title = element_blank(),
		  legend.text = element_text(
		    size = base_size * 0.8,
		    margin = margin(r = 10)
		  ),
		  #legend.key = element_blank(),
		  legend.spacing = unit(0.1, "cm"),
		  legend.box.spacing = unit(0.1, "cm")
	) +

snippet ggfacet
	facet_wrap(
		~ ${1:variable},
		ncol = ${2:3},
		scales = "${3:free_y}"
	) +
	
snippet ggannotate
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning
	annotate(
		"${1:text}",
		x = ${2:x_position}, 
		y = ${3:y_position},  
		# If have discrete y labels but a continuous y axis, use line below
		# y = plot_data |> filter(discrete_y == "y_label") |> pull(cont_y_variable),
		hjust = 0,    # left-justified at x position
		vjust = 0.5,  # centre-aligned at y positionn
		label = "${4:Annotation text}",
		size = ${5:3.2},
		fontface = "bold",
		color = "${6:grey30}"
	) +
	
snippet gggridx
	theme(
		axis.line.x = element_blank(),
		axis.ticks.x = element_blank(),
		axis.text.x = element_text(margin = margin(t = 0, b = 1)),
		panel.grid.major.x = element_line(
			color = cowboysilver, 
			linewidth = 0.3
		)
	) +
	
snippet ggguides
	guides(x = guide_axis(minor.ticks = TRUE)) +

snippet ggsave
	ggsave(
		filename = here("${1:output}", "${2:plot_name}.png"),
		width = ${3:8}, 
		height = ${4:6},
		dpi = 300,
		bg = "white"
	) +

snippet	ggvertbar_text
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning 
	geom_text(
	  data = \(x) filter(x, filter_var == "filter_value"),  # filter if want to label subset of stacked bars
	  aes(label = comma(value_var, accuracy = 1), y = y_value),
	  color = "white",
	  size = 3.2
	) +

snippet gggeom_text
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning
	geom_text(
	  aes(
	    x = ${1:x_variable},
	    y = ${2:y_variable},
	    label = ${3:label_variable}
	  ),
	  colour = "${4:grey30}",
	  size = ${5:3.2},
	  fontface = "${6:plain}",      # plain, bold, italic, bold.italic
	  hjust = ${7:0.5},             # 0 = left, 0.5 = centre, 1 = right
	  vjust = ${8:0.5},             # 0 = bottom, 0.5 = centre, 1 = top
	  nudge_x = ${9:0},
	  nudge_y = ${10:0},
	  angle = ${11:0},
	  lineheight = ${12:1.2},       # for multi-line labels via \n
	  na.rm = TRUE,
	  inherit.aes = ${13:FALSE}
	) +

snippet gglabel
	# fix fig.height=5, fig.width=7 (or whatever dimensions you need) in cell header before tweaking positioning
	geom_label(
	  aes(
	    x = ${1:x_variable},
	    y = ${2:y_variable},
	    label = ${3:label_variable}
	  ),
	  colour = "${4:grey30}",        # text colour
	  fill = "${5:white}",          # box background colour
	  linewidth = ${6:0},           # box border width; 0 = no border
	  size = ${7:3.2},
	  fontface = "${8:plain}",      # plain, bold, italic, bold.italic
	  hjust = ${9:0.5},             # 0 = left, 0.5 = centre, 1 = right
	  vjust = ${10:0.5},            # 0 = bottom, 0.5 = centre, 1 = top
	  nudge_x = ${11:0},
	  nudge_y = ${12:0},
	  label.padding = unit(${13:0.25}, "lines"),  # internal padding around text
	  label.r = unit(${14:0.15}, "lines"),        # corner radius; 0 = square corners
	  na.rm = TRUE,
	  inherit.aes = ${15:FALSE}
	) +
	
