# ---- R / RStudio ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron
.env
*.Rproj.user

# ---- Quarto build outputs (regenerated by `quarto render`) ----
/_site/
/.quarto/
/cache/
*_cache/
posts/**/*_files/
**/*.quarto_ipynb

# ---- Data ----
# Raw inputs are never committed. Each post's R/01_get_data.R re-creates them
# (download from source or from the post's GitHub Release).
**/data-raw/
# Large clean files (> 25 MB) are listed here explicitly by /share-data
# and live in GitHub Releases instead.
# The crime post has not been migrated to the data-raw/ + data/ convention yet;
# its whole data folder (5 GB of raw downloads) stays local until it is.
posts/crime/data/

# ---- Background reading (copyrighted PDFs etc.) ----
# Lives outside the repo at ../chartingwaterlooregion-background/<slug>/
**/[Bb]ackground/

# ---- Deployment leftovers ----
rsconnect/
_publish.yml
posts/*/app/rsconnect/

# ---- Editor / OS ----
.positai
.DS_Store
Thumbs.db
